# Names only. Set values in the host environment (Vercel project settings).
# Do not commit filled-in env files.

# Decision-1 (Microsoft Entra client secret). Tenant and client id are fixed in server code.
AZURE_CLIENT_SECRET=

# Shared rate-limit storage (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Demo passcode gate. SESSION_SECRET signs the HttpOnly session cookie.
# SESSION_SECRET must be at least 16 characters. Generate it outside the repo.
DEMO_PASSCODE=
SESSION_SECRET=

# Must stay unset or not "1" when VERCEL_ENV=production. The build fails otherwise.
DEMO_FAULT_INJECTION=

# Frontend only. Set to 1 to use lib/mock-api.ts instead of the API routes.
# Default off. Do not put secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_USE_MOCK=

# Frontend only. Leave unset to replay fixtures/arena-attacks.json in the browser.
# Set to 1 to POST capped history to /api/arena/round.
NEXT_PUBLIC_ARENA_LIVE_ATTACKER=

# Live arena attacker. Leave unset to replay fixtures/arena-attacks.json.
# These credentials are separate from Decision-1 and must never be the Azure client secret.
ARENA_LIVE_ATTACKER=
ATTACKER_ENDPOINT=
ATTACKER_API_KEY=
ATTACKER_MODEL=
